\@writefile{toc}{\contentsline {subsection}{1.1 深亚周期超快光脉冲的理论预言（已发表）}{1}{subsection*.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 打破光学脉冲半周期极限的原理示意图。（a）ICS 散射几何：相对论电子与约束光场中的光子碰撞，散射辐射以角度 $\theta $ 出射；（b）ICS 前辐射强度分布，$\text  {FWHM} \approx \lambda /2$（受限于半周期极限）；（c）ICS 后辐射强度分布，$\text  {FWHM} \ll \lambda /2$（打破半周期极限）。引自 Dang et al., Phys.\ Rev.\ A \textbf  {112}, 013510 (2025)。}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:scheme}{{1}{2}{打破光学脉冲半周期极限的原理示意图。（a）ICS 散射几何：相对论电子与约束光场中的光子碰撞，散射辐射以角度 $\theta $ 出射；（b）ICS 前辐射强度分布，$\text {FWHM} \approx \lambda /2$（受限于半周期极限）；（c）ICS 后辐射强度分布，$\text {FWHM} \ll \lambda /2$（打破半周期极限）。引自 Dang et al., Phys.\ Rev.\ A \textbf {112}, 013510 (2025)。}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 单电子逆康普顿散射产生深亚周期脉冲。（a）ICS 系统示意：CdS 纳米线间隙产生深亚波长约束光场，单电子垂直入射与光子碰撞；（b）约束光场空间强度分布 $S(z)$，$\text  {FWHM}_S = 77$ nm；（c）散射脉冲时域波形（DSC vs.\ 高斯），$\text  {FWHM}_T = 21$ as；（d）电场 $|E(t)|^2$ 时域分布；（e）频谱 $|E(\nu )|^2$，峰值频率 $\nu _p = 2.0$ PHz。引自 Dang et al., Phys.\ Rev.\ A \textbf  {112}, 013510 (2025)。}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:single-electron}{{2}{3}{单电子逆康普顿散射产生深亚周期脉冲。（a）ICS 系统示意：CdS 纳米线间隙产生深亚波长约束光场，单电子垂直入射与光子碰撞；（b）约束光场空间强度分布 $S(z)$，$\text {FWHM}_S = 77$ nm；（c）散射脉冲时域波形（DSC vs.\ 高斯），$\text {FWHM}_T = 21$ as；（d）电场 $|E(t)|^2$ 时域分布；（e）频谱 $|E(\nu )|^2$，峰值频率 $\nu _p = 2.0$ PHz。引自 Dang et al., Phys.\ Rev.\ A \textbf {112}, 013510 (2025)。}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 电子束团入射时深亚周期脉冲的产生与压缩。（a）束团 ICS 系统示意：电子束团穿过蓝宝石棱镜耦合线对的约束光场；（b）输出脉冲时域波形（DSC vs.\ 高斯），$\tau = 3.6$ fs；（c）电场 $E(t)$；（d）频谱 $|E(\nu )|$，$\nu _p = 26$ THz（中红外）；（e）进一步提高电子能量后的压缩脉冲，$\tau = 180$ as，$\nu _p = 0.49$ PHz（可见光）；（f）极致压缩脉冲，$\tau = 86$ as，$\nu _p = 2.0$ PHz（极紫外）。引自 Dang et al., Phys.\ Rev.\ A \textbf  {112}, 013510 (2025)。}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:bunch}{{3}{4}{电子束团入射时深亚周期脉冲的产生与压缩。（a）束团 ICS 系统示意：电子束团穿过蓝宝石棱镜耦合线对的约束光场；（b）输出脉冲时域波形（DSC vs.\ 高斯），$\tau = 3.6$ fs；（c）电场 $E(t)$；（d）频谱 $|E(\nu )|$，$\nu _p = 26$ THz（中红外）；（e）进一步提高电子能量后的压缩脉冲，$\tau = 180$ as，$\nu _p = 0.49$ PHz（可见光）；（f）极致压缩脉冲，$\tau = 86$ as，$\nu _p = 2.0$ PHz（极紫外）。引自 Dang et al., Phys.\ Rev.\ A \textbf {112}, 013510 (2025)。}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{1.2 纳米线瓦量级连续波导波实验（已投稿）}{5}{subsection*.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces CdS 和 ZnO 纳米线的结构与光学表征。（a）550 nm 直径 CdS 纳米线 SEM 图像；（b）130 nm 直径 CdS 纳米线 HR-TEM 图像（晶格条纹）；（c）690 nm 直径 ZnO 纳米线 SEM 图像；（d）480 nm 直径 ZnO 纳米线 HR-TEM 图像；（e）光致发光（PL）光谱：ZnO（紫色）与 CdS（绿色）；（f）纳米线导波光的光学照片。引自投稿论文 Dang et al.。}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:nanowire-sem}{{4}{5}{CdS 和 ZnO 纳米线的结构与光学表征。（a）550 nm 直径 CdS 纳米线 SEM 图像；（b）130 nm 直径 CdS 纳米线 HR-TEM 图像（晶格条纹）；（c）690 nm 直径 ZnO 纳米线 SEM 图像；（d）480 nm 直径 ZnO 纳米线 HR-TEM 图像；（e）光致发光（PL）光谱：ZnO（紫色）与 CdS（绿色）；（f）纳米线导波光的光学照片。引自投稿论文 Dang et al.。}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 纳米线高功率 CW 导波实验。（a）实验装置示意：EDFA 光源—光纤锥—纳米线—光纤锥—功率计；（b）CdS 纳米线（1550 nm，上）和 ZnO 纳米线（532 nm，下）的明场/暗场光学照片；（c）CdS 纳米线在 1550 nm 的输出—输入功率曲线，最大输出达 2.5 W；（d）ZnO 纳米线在 1550 nm（292 mW）和 532 nm（33 mW）的导波功率曲线。引自投稿论文 Dang et al.。}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:high-power}{{5}{6}{纳米线高功率 CW 导波实验。（a）实验装置示意：EDFA 光源—光纤锥—纳米线—光纤锥—功率计；（b）CdS 纳米线（1550 nm，上）和 ZnO 纳米线（532 nm，下）的明场/暗场光学照片；（c）CdS 纳米线在 1550 nm 的输出—输入功率曲线，最大输出达 2.5 W；（d）ZnO 纳米线在 1550 nm（292 mW）和 532 nm（33 mW）的导波功率曲线。引自投稿论文 Dang et al.。}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 高功率 CW 导波下的非线性频率转换。SHG 转换效率达 $6.9 \times 10^{-6}$，与脉冲激发条件可比。引自投稿论文 Dang et al.。}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:harmonic}{{6}{7}{高功率 CW 导波下的非线性频率转换。SHG 转换效率达 $6.9 \times 10^{-6}$，与脉冲激发条件可比。引自投稿论文 Dang et al.。}{figure.6}{}}
